{
  "name": "bag-heist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:testnet": "vite --host 127.0.0.1 --mode testnet",
    "build": "node scripts/build-contract.mjs && pnpm build:web",
    "build:web": "tsc --noEmit && vite build",
    "build:contract": "node scripts/build-contract.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm test:unit && pnpm test:rust",
    "test:unit": "vitest run",
    "test:rust": "node scripts/rust-test.mjs",
    "test:sandbox": "node scripts/run-sandbox.mjs",
    "test:browser": "playwright test",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "testnet:prepare": "tsx scripts/testnet.ts prepare",
    "testnet:deploy": "node scripts/deploy-testnet.mjs",
    "demo:testnet:record": "tsx scripts/record-testnet.mjs",
    "verify:browser:live": "node scripts/smoke-live.mjs",
    "demo:testnet": "tsx scripts/testnet.ts demo",
    "verify:release": "tsx scripts/verify-testnet.ts --release-only",
    "verify:testnet": "tsx scripts/verify-testnet.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/spline-sans-mono": "5.3.0",
    "@fontsource/big-shoulders-stencil-display": "5.3.0",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@noble/hashes": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "binaryen": "132.0.0",
    "near-api-js": "7.4.0",
    "near-sandbox": "0.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
